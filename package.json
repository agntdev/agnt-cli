{
  "name": "@agntdev/cli",
  "description": "Builder-only CLI for the agntdev bot-building pipeline. Discover claimable work, inspect task DAGs, claim a task, dry-run review, ship a PR, get paid.",
  "version": "0.14.1",
  "author": "AGNT <https://github.com/agntdev>",
  "contributors": [
    "Stanislav Smirnov <https://github.com/laontme>"
  ],
  "bin": {
    "agnt": "./bin/run.js"
  },
  "bugs": {
    "url": "https://github.com/agntdev/agnt-cli/issues"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5.6.2",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@oclif/test": "^4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25",
    "eslint-plugin-perfectionist": "^5.9.0",
    "nock": "^14.0.13",
    "oclif": "^4",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.62.0",
    "shx": "^0.4.0",
    "ts-node": "^10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "./bin/run.js",
    "./bin/run.cmd",
    "./dist",
    "./LICENSE",
    "./README.md",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/agntdev/agnt-cli",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "agnt",
    "dirname": "agnt",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agntdev/agnt-cli.git"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "oxlint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest",
    "test": "vitest run",
    "types": "openapi-typescript https://api.agnt-gm.ai/openapi.json -o src/lib/api-types.ts"
  },
  "types": "dist/index.d.ts"
}
