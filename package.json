{
  "name": "agnt-cli",
  "description": "A new CLI generated with oclif",
  "version": "0.1.0",
  "author": "Tongateway <https://github.com/tongateway>",
  "contributors": [
    "Stanislav Smirnov <https://github.com/laontme>"
  ],
  "bin": {
    "agnt": "./bin/run.js"
  },
  "bugs": {
    "url": "https://github.com/tongateway/agnt-cli/issues"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "open": "^11.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@oclif/test": "^4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24",
    "eslint-plugin-perfectionist": "^5.9.0",
    "nock": "^14.0.13",
    "oclif": "^4",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "shx": "^0.4.0",
    "ts-node": "^10",
    "typescript": "^5.9.3",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/tongateway/agnt-cli",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "agnt",
    "dirname": "agnt",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tongateway/agnt-cli.git"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "oxlint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "types": "openapi-typescript https://api.agnt-gm.ai/openapi.json -o src/lib/api-types.ts",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
